{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "PARISH_IMAGES",
      "bucket_name": "icp-parish-images"
    }
  ],
  "vars": {
    "MAX_UPLOAD_BYTES": "5242880",
    "TURNSTILE_REQUIRED": "false",
    "CORS_ORIGINS": "http://localhost:5173,https://icp-parish.netlify.app"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
